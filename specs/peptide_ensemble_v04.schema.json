{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "peptide_ensemble_v04.schema.json",
  "title": "V0.4 multi-peptide ensemble analysis spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "analysis_id", "candidate", "sequence", "peptide_length",
    "group", "template_id", "receptor_id", "receptor_registry_path",
    "receptor_registry_sha256", "chemistry_contract_path",
    "chemistry_contract_sha256", "receptor_monomer_path",
    "receptor_dimer_path", "docking_receptor_pdbqt_path", "receptor_chain",
    "target_residues", "screening_protocol_status", "comparison_protocol_id",
    "vina_score_primary_source", "score_crosscheck_tolerance_kcal_mol",
    "ligand_preparation", "docking_protocol", "expected_total_pose_count",
    "conformers", "contact_cutoffs", "representative_selection_rules", "summary_rules"
  ],
  "properties": {
    "schema_version": {"const": "0.4"},
    "analysis_id": {"type": "string", "minLength": 1},
    "candidate": {"type": "string", "minLength": 1},
    "sequence": {"type": "string", "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$"},
    "peptide_length": {"type": "integer", "minimum": 1},
    "group": {"type": "string", "minLength": 1},
    "template_id": {"type": "string", "minLength": 1},
    "receptor_id": {"type": "string", "minLength": 1},
    "receptor_registry_path": {"$ref": "#/$defs/relativePath"},
    "receptor_registry_sha256": {"$ref": "#/$defs/sha256"},
    "chemistry_contract_path": {"$ref": "#/$defs/relativePath"},
    "chemistry_contract_sha256": {"$ref": "#/$defs/sha256"},
    "receptor_monomer_path": {"$ref": "#/$defs/relativePath"},
    "receptor_dimer_path": {"$ref": "#/$defs/relativePath"},
    "docking_receptor_pdbqt_path": {"$ref": "#/$defs/relativePath"},
    "receptor_chain": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
    "target_residues": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "screening_protocol_status": {
      "enum": ["formal_standardized", "legacy_regression_only"]
    },
    "comparison_protocol_id": {"type": "string", "minLength": 1},
    "vina_score_primary_source": {"const": "docking_output_pdbqt_remark"},
    "score_crosscheck_tolerance_kcal_mol": {"const": 0.001},
    "ligand_preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "formal_charge"],
      "properties": {
        "protocol_id": {"type": "string", "minLength": 1},
        "formal_charge": {"type": "integer"}
      }
    },
    "docking_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id", "engine", "version", "scoring_function", "score_units",
        "score_direction", "exhaustiveness", "num_modes", "energy_range", "seed",
        "cpu", "box_center_A", "box_size_A"
      ],
      "properties": {
        "protocol_id": {"type": "string", "minLength": 1},
        "engine": {"const": "AutoDock Vina"},
        "version": {"type": "string", "minLength": 1},
        "scoring_function": {"const": "vina"},
        "score_units": {"const": "kcal/mol"},
        "score_direction": {"const": "lower_is_better"},
        "exhaustiveness": {"type": "integer", "minimum": 1},
        "num_modes": {"type": "integer", "minimum": 1},
        "energy_range": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer"},
        "cpu": {"type": "integer", "minimum": 1},
        "box_center_A": {"$ref": "#/$defs/vector3"},
        "box_size_A": {"$ref": "#/$defs/positiveVector3"}
      }
    },
    "expected_total_pose_count": {"type": "integer", "minimum": 1},
    "conformers": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/conformer"}
    },
    "contact_cutoffs": {
      "type": "object", "additionalProperties": false,
      "required": ["direct_A", "near_A"],
      "properties": {"direct_A": {"const": 4.0}, "near_A": {"const": 5.0}}
    },
    "representative_selection_rules": {"$ref": "#/$defs/representativeRules"},
    "summary_rules": {"$ref": "#/$defs/summaryRules"},
    "input_sha256": {"$ref": "#/$defs/inputHashes"}
  },
  "$defs": {
    "relativePath": {
      "type": "string", "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/]).+"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "vector3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "number"}
    },
    "positiveVector3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "conformer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conformer_name", "starting_sdf_path", "ligand_pdbqt_path",
        "vina_config_path", "vina_log_path", "docking_output_path",
        "pose_metrics_path", "expected_model_count"
      ],
      "properties": {
        "conformer_name": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
        "starting_sdf_path": {"$ref": "#/$defs/relativePath"},
        "ligand_pdbqt_path": {"$ref": "#/$defs/relativePath"},
        "vina_config_path": {"$ref": "#/$defs/relativePath"},
        "vina_log_path": {"$ref": "#/$defs/relativePath"},
        "docking_output_path": {"$ref": "#/$defs/relativePath"},
        "pose_metrics_path": {"$ref": "#/$defs/relativePath"},
        "expected_model_count": {"type": "integer", "minimum": 1}
      }
    },
    "representativeRules": {
      "type": "object", "additionalProperties": false,
      "required": [
        "max_receptor_clash_pairs", "max_chain_B_clash_pairs",
        "min_direct_target_contacts", "required_any_direct_residues",
        "max_per_conformer", "diversity_key"
      ],
      "properties": {
        "max_receptor_clash_pairs": {"const": 0},
        "max_chain_B_clash_pairs": {"const": 0},
        "min_direct_target_contacts": {"type": "integer", "minimum": 1},
        "required_any_direct_residues": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "max_per_conformer": {"type": "integer", "minimum": 1, "maximum": 3},
        "diversity_key": {"const": "exact_direct_contact_pattern"}
      }
    },
    "summaryRules": {
      "type": "object", "additionalProperties": false,
      "required": ["recurrent_contact_frequency_min"],
      "properties": {
        "recurrent_contact_frequency_min": {
          "type": "number", "minimum": 0, "maximum": 1
        }
      }
    },
    "inputHashes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receptor_monomer_path": {"$ref": "#/$defs/sha256"},
        "receptor_dimer_path": {"$ref": "#/$defs/sha256"},
        "docking_receptor_pdbqt_path": {"$ref": "#/$defs/sha256"},
        "conformers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  }
}
