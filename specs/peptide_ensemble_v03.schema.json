{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "peptide_ensemble_v03.schema.json",
  "title": "V0.3 peptide ensemble analysis spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "analysis_id", "candidate", "sequence", "group",
    "receptor_monomer_path", "receptor_dimer_path", "receptor_chain",
    "target_residues", "expected_total_pose_count", "conformers",
    "contact_cutoffs", "representative_selection_rules", "summary_rules"
  ],
  "properties": {
    "schema_version": {"const": "0.3"},
    "analysis_id": {"type": "string", "minLength": 1},
    "candidate": {"type": "string", "minLength": 1},
    "sequence": {"type": "string", "minLength": 1},
    "group": {"type": "string", "minLength": 1},
    "receptor_monomer_path": {"$ref": "#/$defs/relativePath"},
    "receptor_dimer_path": {"$ref": "#/$defs/relativePath"},
    "receptor_chain": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
    "target_residues": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "expected_total_pose_count": {"type": "integer", "minimum": 1},
    "conformers": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/conformer"}
    },
    "contact_cutoffs": {
      "type": "object", "additionalProperties": false,
      "required": ["direct_A", "near_A"],
      "properties": {"direct_A": {"const": 4.0}, "near_A": {"const": 5.0}}
    },
    "representative_selection_rules": {
      "type": "object", "additionalProperties": false,
      "required": [
        "max_receptor_clash_pairs", "max_chain_B_clash_pairs",
        "min_direct_target_contacts",
        "required_any_direct_residues", "max_per_conformer", "diversity_key"
      ],
      "properties": {
        "max_receptor_clash_pairs": {"const": 0},
        "max_chain_B_clash_pairs": {"const": 0},
        "min_direct_target_contacts": {"type": "integer", "minimum": 1},
        "required_any_direct_residues": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "max_per_conformer": {"type": "integer", "minimum": 1, "maximum": 3},
        "diversity_key": {"const": "exact_direct_contact_pattern"}
      }
    },
    "summary_rules": {
      "type": "object", "additionalProperties": false,
      "required": ["recurrent_contact_frequency_min"],
      "properties": {
        "recurrent_contact_frequency_min": {
          "type": "number", "minimum": 0, "maximum": 1
        }
      }
    },
    "input_sha256": {"$ref": "#/$defs/inputHashes"}
  },
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "conformer": {
      "type": "object", "additionalProperties": false,
      "required": [
        "conformer_name", "docking_output_path", "pose_metrics_path",
        "expected_model_count"
      ],
      "properties": {
        "conformer_name": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
        "docking_output_path": {"$ref": "#/$defs/relativePath"},
        "pose_metrics_path": {"$ref": "#/$defs/relativePath"},
        "expected_model_count": {"type": "integer", "minimum": 1}
      }
    },
    "inputHashes": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "receptor_monomer_path": {"$ref": "#/$defs/sha256"},
        "receptor_dimer_path": {"$ref": "#/$defs/sha256"},
        "conformers": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "docking_output_path": {"$ref": "#/$defs/sha256"},
              "pose_metrics_path": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    }
  }
}
